{
  "name": "@portabletext/toolkit",
  "version": "6.1.1",
  "description": "Toolkit of handy utility functions for dealing with Portable Text",
  "keywords": [
    "cms",
    "content",
    "headless",
    "portable-text",
    "portable-text-toolkit",
    "realtime",
    "sanity"
  ],
  "homepage": "https://github.com/portabletext/toolkit#readme",
  "bugs": {
    "url": "https://github.com/portabletext/toolkit/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/portabletext/toolkit.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "coverage": "vitest run --coverage",
    "docs:build": "typedoc",
    "format": "oxfmt .",
    "lint": "oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives",
    "prepublishOnly": "pnpm build",
    "release": "changeset publish",
    "test": "vitest"
  },
  "dependencies": {
    "@portabletext/types": "^4.0.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@sanity/tsconfig": "^2.2.1",
    "@sanity/tsdown-config": "^0.33.0",
    "@types/node": "^26.6.11",
    "@vitest/coverage-v8": "^5.1.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "tsdown": "^0.23.7",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.23.0"
}
